{
  "name": "muji-hotel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS='--no-experimental-webstorage' next dev",
    "build": "cross-env NODE_OPTIONS='--no-experimental-webstorage' next build",
    "start": "cross-env NODE_OPTIONS='--no-experimental-webstorage' next start",
    "lint": "eslint .",
    "audit:check": "npm audit --audit-level=moderate",
    "audit:full": "npm audit",
    "audit:summary": "npm audit --json | node -e \"const data = JSON.parse(require('fs').readFileSync(0, 'utf-8')); console.log(`Total: ${data.metadata.vulnerabilities.total} | Info: ${data.metadata.vulnerabilities.info} | Low: ${data.metadata.vulnerabilities.low} | Moderate: ${data.metadata.vulnerabilities.moderate} | High: ${data.metadata.vulnerabilities.high} | Critical: ${data.metadata.vulnerabilities.critical}`);\""
  },
  "dependencies": {
    "@sanity/client": "^7.27.0",
    "@sanity/vision": "^6.17.0",
    "@stripe/stripe-js": "^9.17.0",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "fix": "^0.0.6",
    "next": "^16.3.8",
    "next-auth": "^4.24.15",
    "next-sanity": "^13.3.4",
    "react": "^19.3.0",
    "react-chartjs-2": "^5.3.1",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.3.0",
    "react-hot-toast": "^2.6.1",
    "react-icons": "^5.7.0",
    "sanity": "^6.17.0",
    "stripe": "^22.6.2",
    "swr": "^2.5.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/event-source-polyfill": "^1.0.5",
    "@types/hast": "^3.0.5",
    "@types/node": "^26.6.4",
    "@types/normalize-package-data": "^2.4.4",
    "@types/react": "^19.3.0",
    "@types/react-datepicker": "^6.2.0",
    "@types/react-dom": "^19.3.0",
    "@types/unist": "^3.0.3",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "glob": "^11.1.0",
    "undici": "^8.3.0",
    "ws": "^8.21.0",
    "jsdom": "^27.4.0",
    "uuid": "11.1.1",
    "js-yaml": "^4.1.0",
    "underscore": "^1.13.8",
    "@module-federation/dts-plugin": "2.9.2",
    "@module-federation/vite": "1.23.1",
    "@vercel/frameworks": "3.35.0",
    "smol-toml": "^1.9.0",
    "next": {
      "postcss": "^8.5.15"
    },
    "underscore.string": "^3.3.6",
    "postcss": ""
  },
  "lavamoat": {
    "allowScripts": {
      "eslint-config-next>eslint-import-resolver-typescript>unrs-resolver": false,
      "next>sharp": false,
      "sanity>@sanity/cli>tsx>esbuild": false
    }
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.2": true
  }
}
